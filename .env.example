# =============================================================================
# RidgeLine Roofing — Whop Websites Configuration
# =============================================================================
# When deployed via `whop apps deploy`, Whop automatically injects:
#   - WHOP_ACCOUNT_ID  (your biz_xxx account ID)
#   - WHOP_API_ORIGIN  (https://api.whop.com)
#   - Edge-attached business API key on outbound server requests
#   - Automatic Whop pixel (`window.whop.track`) on every page
#
# Set custom runtime bindings in production via:
#   whop apps secrets set --secret WHOP_PRODUCT_ID=prod_xxx
#   whop apps secrets set --secret WHOP_PLAN_INSPECTION=plan_xxx
#   whop apps secrets set --secret WHOP_PLAN_DEPOSIT=plan_xxx
#   whop apps secrets set --secret WHOP_PLAN_FLAT_RATE=plan_xxx
#   whop apps secrets set --secret WHOP_WEBHOOK_SECRET=ws_xxx
#
# For local development outside `whop apps dev`, copy this file to `.dev.vars`.
# =============================================================================

# Environment: "production" (default) or "sandbox" (uses sandbox-api.whop.com + test card 4242...)
WHOP_ENVIRONMENT=sandbox

# Whop Business Account ID (from whop.com/dashboard or sandbox.whop.com/dashboard)
WHOP_ACCOUNT_ID=

# Server-only Whop Account API Key (NEVER prefix with VITE_; automatically managed on Whop Hosting)
# Required locally outside `whop apps dev`, or when WHOP_ENVIRONMENT=sandbox on a deployed site.
WHOP_API_KEY=

# Whop Catalog IDs (auto-created by running `npm run whop:provision`)
WHOP_PRODUCT_ID=
WHOP_PLAN_INSPECTION=
WHOP_PLAN_DEPOSIT=
WHOP_PLAN_FLAT_RATE=
WHOP_PLAN_FINAL_BALANCE=

# Webhook signing secret (from Dashboard -> Developer -> Webhooks, starts with ws_)
WHOP_WEBHOOK_SECRET=

# Optional office billing key for POST/GET /api/invoices, GET /api/leads, and GET /api/payment-methods.
# Leave empty during Whop sandbox review so reviewers can issue test final invoices directly;
# set a strong passphrase on a production contractor deployment to restrict invoice issuance to staff.
WHOP_ADMIN_KEY=

